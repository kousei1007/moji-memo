{
  "name": "hunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:build": "next build && node electron/prepare.mjs && electron-builder",
    "desktop:pack": "next build && node electron/prepare.mjs && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "idb-keyval": "^6.3.0",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "description": "ふつうの日本語で書いたメモを、ひらがな読みの記号文字で表示するメモアプリ",
  "main": "electron/main.mjs",
  "build": {
    "appId": "app.mojimemo.desktop",
    "productName": "MojiMemo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.mjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app-server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "もじメモ",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
